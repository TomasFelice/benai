---
const cases = [
  {
    title: 'Retail E-commerce',
    category: 'Desarrollo Web',
    desc: 'Plataforma de ventas con sincronización de stock en tiempo real.',
    color: 'bg-gray-100',
  },
  {
    title: 'Fintech App',
    category: 'Mobile App',
    desc: 'Billetera virtual minimalista con enfoque en seguridad.',
    color: 'bg-gray-50',
  },
  {
    title: 'Consultora HR',
    category: 'Branding & Web',
    desc: 'Rebranding completo y portal corporativo.',
    color: 'bg-slate-50',
  },
];
---

<section id="casos" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex justify-between items-end mb-12">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-gray-900">Casos de Éxito</h2>
        <p class="mt-2 text-gray-500">Resultados reales para problemas reales.</p>
      </div>
      <a href="#" class="hidden md:flex items-center text-[#0071E3] font-semibold hover:underline">
        Ver todos
        <svg class="ml-1 w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {cases.map((item) => (
        <div class="group cursor-pointer">
          <div class={`aspect-[4/3] w-full rounded-2xl ${item.color} mb-6 overflow-hidden relative`}>
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-black/5">
              <span class="bg-white px-4 py-2 rounded-full text-sm font-medium shadow-sm">Ver Caso</span>
            </div>
            <!-- Placeholder graphic -->
            <div class="w-full h-full flex items-center justify-center text-gray-300">
              <svg class="w-12 h-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z" />
                <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65" />
                <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65" />
              </svg>
            </div>
          </div>
          <p class="text-xs font-medium text-[#0071E3] uppercase tracking-wide mb-1">{item.category}</p>
          <h3 class="text-xl font-bold text-gray-900 group-hover:text-[#0071E3] transition-colors">{item.title}</h3>
          <p class="mt-2 text-sm text-gray-500">{item.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-8 md:hidden">
      <a href="#" class="flex items-center text-[#0071E3] font-semibold">
        Ver todos los proyectos
        <svg class="ml-1 w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
