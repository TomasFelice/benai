---
---

<section id="carreras" class="py-24 bg-gray-900 text-white overflow-hidden relative">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl mb-6">Únete a Benai.</h2>
      <p class="text-lg text-gray-300 mb-10 font-light">
        Buscamos mentes creativas y técnicas que compartan nuestra obsesión por la calidad. Si crees que menos es más, este es tu lugar.
      </p>

      <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-8 border border-white/10 text-left">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="text-xl font-bold text-white">Envíanos tu Portfolio</h3>
            <p class="text-sm text-gray-400 mt-1">Designers, Developers, PMs. Siempre estamos buscando talento.</p>
          </div>
          <a
            href="mailto:careers@benai.com"
            class="flex items-center gap-2 bg-white text-gray-900 px-6 py-3 rounded-full font-semibold hover:bg-gray-100 transition-colors w-full md:w-auto justify-center"
          >
            <!-- Upload icon -->
            <svg class="w-[18px] h-[18px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="17 8 12 3 7 8" />
              <line x1="12" x2="12" y1="3" y2="15" />
            </svg>
            Aplicar ahora
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative background circle -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[#0071E3] rounded-full opacity-10 blur-[100px] -z-0"></div>
</section>
