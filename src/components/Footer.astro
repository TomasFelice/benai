---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-100 py-12">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="text-center md:text-left">
      <span class="font-sans text-xl font-bold tracking-tight text-gray-900 block">
        Benai<span class="text-[#0071E3]">.</span>
      </span>
      <p class="text-sm text-gray-400 mt-2">© {currentYear} Benai Agency. Todos los derechos reservados.</p>
    </div>

    <nav aria-label="Redes sociales">
      <ul class="flex space-x-6 list-none m-0 p-0">
        <li>
          <a
            href="https://www.instagram.com/benaiagency"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-[#0071E3] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0071E3] rounded-sm"
            aria-label="Seguir a Benai en Instagram (abre en nueva pestaña)"
          >
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
            </svg>
          </a>
        </li>
        <li>
          <a
            href="mailto:felicetomasag@gmail.com"
            class="text-gray-400 hover:text-[#0071E3] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0071E3] rounded-sm"
            aria-label="Enviar email a Benai"
          >
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
