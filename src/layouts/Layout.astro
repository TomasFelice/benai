---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Benai — Potenciamos tu visión',
  description = 'Transformamos ideas complejas en productos digitales simples. Ingeniería robusta y diseño estratégico para marcas que buscan el siguiente nivel.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="font-sans text-gray-900 bg-white antialiased" style="font-family: 'Inter', system-ui, sans-serif;">
    <slot />
  </body>
</html>
