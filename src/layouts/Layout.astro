---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = 'Benai — Potenciamos tu visión',
  description = 'Transformamos ideas complejas en productos digitales simples. Ingeniería robusta y diseño estratégico para marcas que buscan el siguiente nivel.',
  image = 'https://benai.com.ar/og-image.png',
  canonical = 'https://benai.com.ar/',
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Benai',
  url: 'https://benai.com.ar',
  logo: 'https://benai.com.ar/favicon.svg',
  description,
  email: 'felicetomasag@gmail.com',
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'felicetomasag@gmail.com',
    contactType: 'customer service',
    availableLanguage: 'Spanish',
  },
  sameAs: ['https://www.instagram.com/benaiagency'],
  founder: [
    { '@type': 'Person', name: 'Tomás Felice', jobTitle: 'CTO & Tech Lead' },
    { '@type': 'Person', name: 'Candela Dagrosa', jobTitle: 'CPO & Product Lead' },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Benai Agency" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0071E3" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Benai" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="font-sans text-gray-900 bg-white antialiased" style="font-family: 'Inter', system-ui, sans-serif;">
    <a
      href="#contenido-principal"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:rounded-lg focus:bg-[#0071E3] focus:px-4 focus:py-2 focus:text-white focus:font-semibold focus:shadow-lg focus:outline-none"
    >
      Saltar al contenido principal
    </a>
    <slot />
  </body>
</html>
